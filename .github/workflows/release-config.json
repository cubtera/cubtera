{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "changelog-type": "github",
  "commit-search-depth": 10,
  "release-search-depth": 5,
  "plugins": [
    { "type": "linked-versions", "groupName": "cubtera-v2", "components": [
      "cubtera-domain",
      "cubtera-core",
      "cubtera-config",
      "cubtera-persistence",
      "cubtera-runners",
      "cubtera",
      "cubtera-api"
    ] }
  ],
  "packages": {
    "crates/cubtera-domain": { "component": "cubtera-domain" },
    "crates/cubtera-core": { "component": "cubtera-core" },
    "crates/cubtera-config": { "component": "cubtera-config" },
    "crates/cubtera-persistence": { "component": "cubtera-persistence" },
    "crates/cubtera-runners": { "component": "cubtera-runners" },
    "crates/cubtera": { "component": "cubtera" },
    "crates/cubtera-api": { "component": "cubtera-api" }
  },

  "changelog-sections": [
    {
      "title": "Features",
      "type": "feat"
    },
    {
      "title": "Bug Fixes",
      "type": "fix"
    },
    {
      "title": "Documentation",
      "type": "docs"
    },
    {
      "title": "Code Style",
      "type": "style"
    },
    {
      "title": "Refactors",
      "type": "refactor"
    },
    {
      "title": "Tests",
      "type": "test"
    },
    {
      "title": "Build System",
      "type": "build"
    },
    {
      "title": "Continuous Integration",
      "type": "ci"
    },
    {
      "title": "Security",
      "type": "security"
    },
    {
      "title": "Dependencies",
      "type": "deps"
    },
    {
      "title": "Breaking Changes",
      "type": "breaking"
    }
  ]
}
